# Memoire environment
#
# Memoire is a personal commercial control tower with NO AI dependency.
# Capture parsing, prioritisation, search and recommendations are deterministic
# and run on the user's device. There is deliberately no AI provider key here:
# `scripts/verify-no-ai-dependency.mjs` fails the build if one is reintroduced,
# and /api/health reports a warning if one is set in the environment.

# Supabase
SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_ENABLE_DEMO_MODE=false
VITE_ENABLE_FOUNDER_WORKSPACE=false

# Lemon Squeezy (merchant of record: it owns card data, tax and invoicing).
# Checkout stays off until the paid offer, QA, support and legal gates pass -
# see docs/deployment/billing-checkout-exposure-guard-2026-06-17.md.
# There is no client-side billing key: Lemon Squeezy checkout is a hosted URL
# minted server-side by /api/billing.
BILLING_CHECKOUT_ENABLED=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PERSONAL_VARIANT_ID=
LEMONSQUEEZY_TEAM_VARIANT_ID=

# Operational telemetry (optional). Operational events only - never customer content.
VITE_CLIENT_LOG_ENDPOINT=/api/client-log

# App. This is the one canonical application URL: Supabase Site URL, the
# email-verification redirect, the password-recovery redirect, the OAuth return
# URL and the shared-brief base URL must all agree with it.
VITE_APP_URL=http://localhost:5173

# Founder-only import audit page (/app/founder-import). Empty means the page and
# its rail entry do not exist for anybody, which is the default: this used to be
# a personal address compiled into the JavaScript every visitor downloads.
VITE_FOUNDER_IMPORT_EMAIL=
